apt:
  libx11-dev
  libxext-dev
  libxinerama-dev
  libxrandr-dev
  libxss-dev
  libxft-dev

github-patches:
  .github/workflows/haskell-ci-hackage.patch

raw-project
  package X11-xft
    flags: +pedantic

-- avoid --haddock-all which overwrites *-docs.tar.gz with tests docs
haddock-components: libs

-- Ubuntu 22.04 is the last one with libtinfo5, needed by GHC 8.2 and 8.0
distribution: jammy
